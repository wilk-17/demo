	"item": [
		{
			"name": "1. Autenticación",
			"item": [
				{
					"name": "1.1 Login - Usuario Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.environment.set(\"token\", jsonData.token);",
									"    pm.environment.set(\"username\", jsonData.username);",
									"    pm.environment.set(\"userId\", jsonData.id);",
									"    console.log(\"Token guardado: \" + jsonData.token.substring(0, 20) + \"...\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"admin\",\n    \"password\": \"admin123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Login con usuario admin. Guarda automáticamente el token JWT."
					},
					"response": []
				},
				{
					"name": "1.2 Login - Usuario Gerente",
